PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/renderloop
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: dedicated key for at-rest encryption (falls back to JWT_SECRET)
ENCRYPTION_KEY=
# Required in production — secret Vercel Cron sends to /api/cron/sweep
CRON_SECRET=
